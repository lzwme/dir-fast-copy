{
  "name": "@lzwme/dir-fast-copy",
  "version": "1.6.2",
  "description": "nodejs 实现的文件夹快速复制工具。适用于对存在海量小文件的目录进行选择性复制的需求场景。",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "bin": {
    "dfc": "bin/dfc.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lzwme/dir-fast-copy.git"
  },
  "license": "MIT",
  "keywords": [
    "fast",
    "copy",
    "cp",
    "文件复制"
  ],
  "author": {
    "name": "lzwme",
    "url": "https://lzw.me"
  },
  "maintainers": [
    {
      "name": "renxia",
      "url": "https://lzw.me"
    }
  ],
  "scripts": {
    "dev": "tsc -w",
    "build": "run-s clean && run-p build:*",
    "build:dist": "tsc -p tsconfig.json",
    "lint": "npm run check:tsc && npm run fix",
    "check:tsc": "tsc --noEmit",
    "check": "biome check src/",
    "fix": "pnpm check --fix",
    "test": "run-s build test:*",
    "test:lint": "biome check src/",
    "test:unit": "vitest run",
    "watch": "run-s clean build:dist && run-p \"build:dist -- -w\" \"test:unit -- --watch\"",
    "watch:src": "run-s clean build:dist && run-p \"build:dist -- -w\"",
    "cov": "vitest run --coverage && open-cli coverage/index.html",
    "cov:html": "vitest run --coverage --coverage.reporter=html",
    "cov:send": "vitest run --coverage --coverage.reporter=lcov && codecov",
    "cov:summary": "vitest run --coverage --coverage.reporter=text-summary",
    "cov:check": "vitest run --coverage",
    "version": "standard-version",
    "reset": "git clean -dfx && git reset --hard && pnpm install",
    "clean": "trash dist esm",
    "preinstall": "husky install",
    "prepare-release": "run-s test cov:check version"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "open-cli": "^9.0.0",
    "standard-version": "^9.5.0",
    "trash-cli": "^7.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "console-log-colors": "^0.5.0",
    "glob-to-regexp": "^0.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run lint"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
